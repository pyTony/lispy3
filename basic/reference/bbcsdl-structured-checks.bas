10 REM Structured exit and restoration audit: run all eight checks
20 ON ERROR PRINT "ERROR ";ERR;" AT LINE ";ERL:REPORT:PRINT:END
30 PRINT "1 EXIT FOR":PROCexitfor
40 PRINT "2 EXIT REPEAT":PROCexitrepeat
50 PRINT "3 EXIT WHILE":PROCexitwhile
60 PRINT "4 INNER EXIT FOR":PROCinnerexit
70 PRINT "5 EARLY FN RETURN":PRINT ;FNfirstover(50):PRINT "after"
80 PRINT "6 EARLY ENDPROC":PROCearly(1):PROCearly(-1):PRINT "after"
90 PRINT "7 PARAMETERS AND LOCALS":x=1:y=2:PROCrestore(10):PRINT ;x;" ";y
100 PRINT "8 DYNAMIC LOCAL":v$="global":PROCouter:PROCshow
110 PRINT "ALL CHECKS COMPLETED":END
1000 DEF PROCexitfor
1010 LOCAL i
1020 FOR i=1 TO 10
1030 IF i=3 THEN EXIT FOR
1040 NEXT
1050 PRINT ;i:PRINT "after"
1060 ENDPROC
1100 DEF PROCexitrepeat
1110 LOCAL k
1120 k=0
1130 REPEAT
1140 k+=1
1150 IF k=2 THEN EXIT REPEAT
1160 UNTIL FALSE
1170 PRINT ;k:PRINT "after"
1180 ENDPROC
1200 DEF PROCexitwhile
1210 LOCAL k
1220 k=0
1230 WHILE TRUE
1240 k+=1
1250 IF k=5 THEN EXIT WHILE
1260 ENDWHILE
1270 PRINT ;k:PRINT "after"
1280 ENDPROC
1300 DEF PROCinnerexit
1310 LOCAL i,j
1320 FOR i=1 TO 2
1330 FOR j=1 TO 9
1340 IF j>i THEN EXIT FOR
1350 PRINT ;j;
1360 NEXT
1370 NEXT
1380 PRINT:PRINT "after"
1390 ENDPROC
1400 DEF FNfirstover(limit)
1410 LOCAL i
1420 FOR i=1 TO 100
1430 IF i*i>limit THEN =i
1440 NEXT
1450 =-1
1500 DEF PROCearly(x)
1510 IF x<0 THEN ENDPROC
1520 PRINT "positive"
1530 ENDPROC
1600 DEF PROCrestore(x)
1610 LOCAL y
1620 y=x*2
1630 PRINT ;x;" ";y
1640 ENDPROC
1700 DEF PROCouter
1710 LOCAL v$
1720 v$="outer"
1730 PROCshow
1740 ENDPROC
1800 DEF PROCshow
1810 PRINT v$
1820 ENDPROC

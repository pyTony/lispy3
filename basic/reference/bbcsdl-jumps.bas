10 REM Manual BBCSDL reference checks: run ONE test per RUN
20 ON ERROR PRINT "ERROR ";ERR;" AT LINE ";ERL:REPORT:PRINT:END
30 PRINT "BBCSDL jump checks - record your BBCSDL version"
40 PRINT "1 FOR local jump     2 WHILE local jump"
50 PRINT "3 IF local jump      4 Jump to enclosing FOR"
60 PRINT "5 Jump out of loops  6 Backward WHILE jump"
70 PRINT "7 ELSE local jump    8 ON GOTO in REPEAT"
80 PRINT "9 CASE local jump   10 Missing target"
90 PRINT "11 GOSUB same line  12 Nested GOSUB"
100 PRINT "13 GOSUB in FOR     14 ON GOSUB"
110 INPUT "Test number (1-14): " choice%
120 IF choice%=1 THEN GOTO 1010
130 IF choice%=2 THEN GOTO 2010
140 IF choice%=3 THEN GOTO 3010
150 IF choice%=4 THEN GOTO 4010
160 IF choice%=5 THEN GOTO 5010
170 IF choice%=6 THEN GOTO 6010
180 IF choice%=7 THEN GOTO 7010
190 IF choice%=8 THEN GOTO 8010
200 IF choice%=9 THEN GOTO 9010
210 IF choice%=10 THEN GOTO 10010
220 IF choice%=11 THEN GOTO 11010
230 IF choice%=12 THEN GOTO 12010
240 IF choice%=13 THEN GOTO 13010
250 IF choice%=14 THEN GOTO 14010
260 PRINT "Invalid test number":END
1010 FOR i=1 TO 3
1020 GOTO 1040
1030 PRINT "wrong"
1040 PRINT ;i
1050 NEXT
1060 PRINT "done"
1070 END
2010 n=0
2020 WHILE n<2
2030 n+=1
2040 GOTO 2060
2050 PRINT "wrong"
2060 PRINT ;n
2070 ENDWHILE
2080 PRINT "done"
2090 END
3010 IF TRUE THEN
3020 GOTO 3040
3030 PRINT "wrong"
3040 PRINT "inside"
3050 ENDIF
3060 PRINT "after"
3070 END
4010 FOR i=1 TO 2
4020 IF TRUE THEN
4030 GOTO 4060
4040 ENDIF
4050 PRINT "wrong"
4060 PRINT ;i
4070 NEXT
4080 PRINT "done"
4090 END
5010 FOR i=1 TO 2
5020 IF TRUE THEN
5030 GOTO 5080
5040 ENDIF
5050 PRINT "wrong"
5060 NEXT
5080 PRINT "out"
5090 END
6010 n=0
6020 WHILE n<3
6030 n+=1
6040 IF n<3 THEN GOTO 6030
6050 PRINT ;n
6060 ENDWHILE
6070 END
7010 IF FALSE THEN
7020 PRINT "wrong"
7030 ELSE
7040 GOTO 7060
7050 PRINT "wrong"
7060 PRINT "else"
7070 ENDIF
7080 PRINT "after"
7090 END
8010 n=0
8020 REPEAT
8030 n+=1
8040 ON 1 GOTO 8060,8050
8050 PRINT "wrong"
8060 PRINT ;n
8070 UNTIL n=2
8080 END
9010 CASE 1 OF
9020 WHEN 1
9030 GOTO 9050
9040 PRINT "wrong"
9050 PRINT "case"
9060 OTHERWISE
9070 PRINT "wrong"
9080 ENDCASE
9090 PRINT "after"
9100 END
10010 WHILE TRUE
10020 GOTO 999
10030 ENDWHILE
10040 END
11010 GOSUB 11100 : PRINT "back"
11020 END
11100 PRINT "sub" : RETURN
12010 GOSUB 12100 : PRINT "main" : END
12100 PRINT "outer" : GOSUB 12200 : PRINT "outer back" : RETURN
12200 PRINT "inner" : RETURN
13010 FOR i=1 TO 2
13020 GOSUB 13100
13030 NEXT
13040 PRINT "done" : END
13100 PRINT ;i : RETURN
14010 ON 2 GOSUB 14100,14200 : PRINT "back" : END
14100 PRINT "wrong" : RETURN
14200 PRINT "second" : RETURN

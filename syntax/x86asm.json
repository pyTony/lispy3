{
  "name": "x86 assembly",
  "extensions": [
    ".asm",
    ".nasm",
    ".s86"
  ],
  "line_comment": "; ",
  "case_insensitive": true,
  "rules": [
    {
      "tag": "comment",
      "pattern": ";[^\\n]*"
    },
    {
      "tag": "string",
      "pattern": "'[^'\\n]*'?|\"[^\"\\n]*\"?|`[^`\\n]*`?"
    },
    {
      "tag": "function",
      "pattern": "(?:(?<=\\n)|(?<![\\s\\S]))[.A-Za-z_?$][\\w.?$@]*:"
    },
    {
      "tag": "number",
      "pattern": "\\b(?:0x[0-9a-f]+|[0-9][0-9a-f]*h|[01]+b|\\d+)\\b|\\$\\$?"
    }
  ],
  "word_pattern": "%?[A-Za-z_.][\\w.]*",
  "words": {
    "special": [
      "org",
      "bits",
      "cpu",
      "section",
      "segment",
      "db",
      "dw",
      "dd",
      "dq",

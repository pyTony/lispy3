{
  "name": "BBC BASIC",
  "extensions": [".bas", ".basic"],
  "line_comment": "REM ",
  "case_insensitive": true,
  "rules": [
    {"tag": "string", "pattern": "\"(?:[^\"\\n]|\"\")*\""},
    {"tag": "comment", "pattern": "\\bREM\\b[^\\n]*"},
    {"tag": "number", "pattern": "&[0-9A-F]+|\\b\\d+(?:\\.\\d*)?(?:E[-+]?\\d+)?"}
  ],
  "word_pattern": "[A-Z_][A-Z0-9_]*[%$]?",
  "words": {"special": ["FOR", "TO", "STEP", "NEXT", "IF", "THEN", "ELSE", "ENDIF", "WHILE", "ENDWHILE", "REPEAT", "UNTIL", "CASE", "OF", "WHEN", "OTHERWISE", "ENDCASE", "DEF", "PROC", "FN", "ENDPROC", "LOCAL", "LET", "PRINT", "INPUT", "GOTO", "GOSUB", "RETURN", "ON", "END", "STOP", "REM", "DIM", "AND", "OR", "NOT", "MOD", "DIV", "TRUE", "FALSE", "MODE", "GCOL", "COLOUR", "COLOR", "VDU", "ANSI", "CLS", "CLG", "MOVE", "DRAW", "PLOT", "ORIGIN", "TIME", "TAB"]}
}

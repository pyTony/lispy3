{
  "name": "Python",
  "extensions": [
    ".py",
    ".pyw"
  ],
  "line_comment": "#",
  "env_words": false,
  "colors": {
    "comment": "#6a9955",
    "string": "#ce9178",
    "keyword": "#c586c0",
    "constant": "#569cd6",
    "number": "#b5cea8",
    "builtin": "#4ec9b0",
    "variable": "#9cdcfe",
    "function": "#dcdcaa",
    "decorator": "#dcdcaa"
  },
  "rules": [
    {
      "tag": "string",
      "pattern": "(?<!\\w)(?i:[rbuf]{0,2})(?:'''[\\s\\S]*?(?:'''|\\Z)|\\\"\\\"\\\"[\\s\\S]*?(?:\\\"\\\"\\\"|\\Z))"
    },
    {
      "tag": "string",
      "pattern": "(?<!\\w)(?i:[rbuf]{0,2})(?:'(?:[^'\\\\\\n]|\\\\[\\s\\S])*'?|\"(?:[^\"\\\\\\n]|\\\\[\\s\\S])*\"?)"
    },
    {
      "tag": "comment",
      "pattern": "#[^\\n]*"
    },
    {
      "tag": "decorator",
      "pattern": "(?<![\\w)\\]])@[A-Za-z_][\\w.]*"
    },
    {
      "tag": "function",
      "pattern": "(?<=\\bdef )[A-Za-z_]\\w*|(?<=\\bclass )[A-Za-z_]\\w*"
    },
    {
      "tag": "number",
      "pattern": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|(?:\\d[\\d_]*\\.?[\\d_]*|\\.\\d[\\d_]*)(?:[eE][-+]?\\d+)?[jJ]?)(?![\\w.])"
    }
  ],
  "word_pattern": "[A-Za-z_]\\w*",
  "words": {
    "constant": [
      "True",
      "False",
      "None",
      "Ellipsis",
      "NotImplemented"
    ],
    "keyword": [
      "and",
      "as",
      "assert",
      "async",
      "await",
      "break",
      "class",
      "continue",
      "def",
      "del",
      "elif",
      "else",
      "except",
      "finally",
      "for",
      "from",
      "global",
      "if",
      "import",
      "in",
      "is",
      "lambda",
      "nonlocal",
      "not",
      "or",
      "pass",
      "raise",
      "return",
      "try",
      "while",
      "with",
      "yield",
      "case",
      "match",
      "type"
    ],
    "variable": [
      "self",
      "cls"
    ],
    "builtin": [

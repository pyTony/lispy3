; DEF-PROC and DEF-FN: parameters, LOCAL, dynamic scope, early exits and END
(bbc-program
  (PROC greet "Tony" 2)
  (PRINT (FN sign -5) :semi (FN sign 0) :semi (FN sign 7))
  (PROC p 1)
  (PROC p -1)
  (PRINT "first-over 50 = " :semi (FN first-over 50))
  (LET x 1)
  (LET y 2)
  (PROC scoped 10)
  (PRINT "after: " :semi x :semi " " :semi y)
  (LET v "global")
  (PROC outer)
  (PROC show)
  (PRINT "fib 15 = " :semi (FN fib 15))
  (PROC stop)
  (PRINT "not reached")
  (DEF-PROC (greet name$ times) (FOR i 1 times (PRINT "Hi " :semi name$)))
  (DEF-FN (sign x) (IF (< x 0) (FN= -1)) (IF (= x 0) (FN= 0)) (FN= 1))
  (DEF-PROC (p x) (IF (< x 0) (ENDPROC)) (PRINT "positive"))
  (DEF-FN (first-over limit) (FOR i 1 100 (IF (> (* i i) limit) (FN= i))) (FN= -1))
  (DEF-PROC (scoped x) (LOCAL y) (LET y (* x 2)) (PRINT "inside: " :semi x :semi " " :semi y))
  (DEF-PROC (outer) (LOCAL v) (LET v "outer") (PROC show))
  (DEF-PROC (show) (PRINT v))
  (DEF-FN (fib n) (IF (< n 2) (FN= n) ELSE (FN= (+ (FN fib (- n 1)) (FN fib (- n 2))))))
  (DEF-PROC (stop) (PRINT "stopping") (END)))

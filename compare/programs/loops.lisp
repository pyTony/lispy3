; FOR ... STEP, REPEAT ... UNTIL, WHILE and the EXIT forms
(bbc-program
  (FOR i 1 3 (PRINT :semi i :semi " " :semi))
  (PRINT "/ i=" :semi i)
  (FOR i 10 1 STEP -4 (PRINT :semi i :semi " " :semi))
  (PRINT)
  (LET s 2)
  (FOR i 1 5 STEP s (PRINT :semi i :semi))
  (PRINT)
  (FOR i 0 1 STEP 0.25 (PRINT :semi i :semi " " :semi))
  (PRINT)
  (FOR i 5 1 (PRINT "FOR runs once"))
  (LET k 0)
  (REPEAT (LET k (+ k 1)) UNTIL (>= k 4))
  (PRINT "REPEAT k=" :semi k)
  (LET k 10)
  (WHILE (< k 3) (LET k (+ k 1)))
  (PRINT "WHILE k=" :semi k)
  (LET k 0)
  (WHILE (< k 3) (LET k (+ k 1)))
  (PRINT "WHILE k=" :semi k)
  (FOR i 1 10 (IF (= i 3) (EXIT-FOR)))
  (PRINT "EXIT-FOR i=" :semi i)
  (LET k 0)
  (REPEAT (LET k (+ k 1)) (IF (= k 2) (EXIT-REPEAT)) UNTIL FALSE)
  (PRINT "EXIT-REPEAT k=" :semi k)
  (LET k 0)
  (WHILE TRUE (LET k (+ k 1)) (IF (= k 5) (EXIT-WHILE)))
  (PRINT "EXIT-WHILE k=" :semi k)
  (FOR i 1 3 (FOR j 1 9 (IF (> j i) (EXIT-FOR)) (PRINT :semi j :semi)) (PRINT " " :semi))
  (PRINT))
